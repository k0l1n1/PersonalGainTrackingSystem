# ==============================================================================
# PERSONAL GAIN TRACKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit your actual .env file with private secrets to version control!
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompanyproject.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key (found in Supabase Dashboard -> Project Settings -> API)
# This key is safe for client applications and automatically enforces Row Level Security (RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-here

# Optional: Supabase PostgreSQL direct connection for administrative tools / JDBC
# Not recommended for client distribution. Prefer REST API with RLS.
# DB_HOST=db.your-project-id.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-database-password
